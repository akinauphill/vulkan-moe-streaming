+
+#ifdef _WIN32
+static std::wstring moe_utf8_to_wide(const std::string & s) {
+    const int n = MultiByteToWideChar(CP_UTF8, 0, s.c_str(), -1, nullptr, 0);
+    std::wstring w(n > 0 ? n - 1 : 0, L'\0');
+    if (n > 1) {
+        MultiByteToWideChar(CP_UTF8, 0, s.c_str(), -1, &w[0], n);
+    }
+    return w;
+}
+
+// one manual-reset event per thread for the overlapped reads (the I/O threads live for the whole run)
+struct moe_thread_event {
+    HANDLE ev = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    ~moe_thread_event() {
+        if (ev) {
+            CloseHandle(ev);
+        }
+    }
+};
+#endif
