+
+typedef bool (*ggml_backend_cuda_register_host_buffer_t)(void * buffer, size_t size);
+typedef void (*ggml_backend_cuda_unregister_host_buffer_t)(void * buffer);
+
+static const uint32_t MOE_STREAM_IO_THREADS_DEFAULT = 9;
+static const uint32_t MOE_STREAM_IO_THREADS_MAX     = 48;
+static const int64_t  MOE_STREAM_HOT_DECAY_TOKENS   = 64;
+
+// O_DIRECT alignment: 4096 is a multiple of any device logical block size (512/4096), so it is
+// universally valid, and reading a few extra KB of head/tail padding per slab is negligible
+static const size_t MOE_STREAM_DIRECT_ALIGN = 4096;
+
+// saturating increment - route-hotness counters accumulate over a whole run and must not wrap
+static uint32_t sat_inc(uint32_t & c) {
+    if (c < UINT32_MAX - 1) {
+        c++;
+    }
+    return c;
+}
+
+// page-aligned allocation, required both for O_DIRECT reads and for Metal private-buffer uploads
+static void * moe_aligned_alloc(size_t n) {
+#ifdef _WIN32
+    return _aligned_malloc(n, MOE_STREAM_DIRECT_ALIGN);
+#else
+    void * p = nullptr;
+    if (posix_memalign(&p, MOE_STREAM_DIRECT_ALIGN, n) != 0) {
+        p = nullptr;
+    }
+    return p;
+#endif
+}
+
+// staging sets: whole pages from the OS, so that their physical memory can be handed back between prefills (a
+//   decode never reads them, and on a machine where the model is several times the RAM, 2 x one layer of experts
+//   left resident is RAM the expert cache needs)
+static void * moe_pages_alloc(size_t n) {
+#ifdef _WIN32
+    return VirtualAlloc(nullptr, n, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+#else
+    void * p = mmap(nullptr, n, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    return p == MAP_FAILED ? nullptr : p;
+#endif
+}
+
+static void moe_pages_free(void * p, size_t n) {
+#ifdef _WIN32
+    GGML_UNUSED(n);
+    VirtualFree(p, 0, MEM_RELEASE);
+#else
+    munmap(p, n);
+#endif
+}
+
+// give the pages' physical memory back; the contents are lost
+static void moe_pages_release(void * p, size_t n) {
+#ifdef _WIN32
+    VirtualFree(p, n, MEM_DECOMMIT);
+#else
+    madvise(p, n, MADV_DONTNEED);
+#endif
+}
+
+// make released pages usable again (zero-filled on first touch)
+static bool moe_pages_recommit(void * p, size_t n) {
+#ifdef _WIN32
+    return VirtualAlloc(p, n, MEM_COMMIT, PAGE_READWRITE) != nullptr;
+#else
+    GGML_UNUSED(p);
+    GGML_UNUSED(n);
+    return true;
+#endif
+}
+
+static void moe_aligned_free(void * p) {
+#ifdef _WIN32
+    _aligned_free(p);
+#else
+    free(p);
+#endif
+}
